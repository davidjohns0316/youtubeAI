# Runway ML — get your key at app.runwayml.com → Settings → API Keys
RUNWAY_API_KEY=

# YouTube — from Google Cloud Console OAuth 2.0 credentials
# (Client ID and Secret are also embedded in youtube_client_secrets.json)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok — from developers.tiktok.com → your app → Manage Keys
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Local server URL (do not change unless running on a different port)
APP_BASE_URL=http://localhost:8000
